datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model user {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  email              String   @unique
  name               String
  password_hash      String
  role               Role     @default(INVESTOR)
  curv_code          String   @unique
  two_factor_secret  String?
  two_factor_enabled Boolean  @default(false)
  total_spent        Float    @default(0.00)
  created_at         DateTime @default(now())

  bonds              bond[]
  transactions       transaction[]
  verification_codes verification_code[]
}

model bond {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id         String   @db.ObjectId
  type            BondType
  amount          Float    @default(100.00)
  code            String   @unique
  qr_data         String?
  certificate_url String?

  user            user     @relation(fields: [user_id], references: [id])
}

model transaction {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  user_id        String        @db.ObjectId
  payment_method PaymentMethod @default(SIMULATED)
  payment_id     String?
  amount         Float
  currency       String        @default("USD")

  user           user          @relation(fields: [user_id], references: [id])
}

model referral {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  referrer_id     String   @db.ObjectId
  referred_id     String   @db.ObjectId
  commission_rate Float    @default(8.00)
  total_earned    Float    @default(0.00)
  created_at      DateTime @default(now())
}

model verification_code {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  user_id String @db.ObjectId
  code    String

  user    user   @relation(fields: [user_id], references: [id])
}

// Asegúrate de conservar tus enums abajo si los tenías definidos:
enum Role {
  INVESTOR
  ADMIN
}

enum BondType {
  STANDARD
  PREMIUM
}

enum PaymentMethod {
  SIMULATED
  STRIPE
}